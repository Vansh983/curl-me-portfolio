---
import Base from './Base.astro';
import '../styles/blog-tmux.css';

type Props = {
  title: string;
  description: string;
  slug: string;
  article?: { published: string; updated?: string };
  next?: string;
};

const { title, description, slug, article, next } = Astro.props;
const bindings = article
  ? [
      ['Esc or q', 'back to all posts'],
      ['o', 'next post'],
      ['arrow keys or j k', 'scroll'],
      ['?', 'show or hide this help'],
    ]
  : [
      ['arrow keys or h j k l', 'move between posts'],
      ['Enter', 'open the post'],
      ['o', 'next post'],
      ['?', 'show or hide this help'],
      ['Esc', 'close this help'],
    ];
---

<Base {title} {description} {article} topbar={false} footer={false} viewportFitCover>
  <div class="blog-tmux" data-mode={article ? 'post' : 'grid'} data-next={next}>
    <div class="blog-window">
      <div class="blog-view"><slot /></div>
      <div class="blog-keys" id="blog-keys" hidden tabindex="-1" role="region" aria-label="Blog help">
        <div class="blog-key-list">
          <dl>
            {bindings.map(([key, action]) => <div><dt class="blog-key">{key}</dt><dd>{action}</dd></div>)}
          </dl>
          <p>Ctrl+b before a key also works, as in tmux.</p>
        </div>
        <nav class="blog-help-links" aria-label="Help navigation">
          <a href="/blog">all posts</a>
          <a href="/">home</a>
          <button type="button" class="blog-close-keys">close</button>
        </nav>
      </div>
    </div>
    <div class="blog-bars">
      <nav class="blog-hints" aria-label="Blog navigation">
        {article ? (
          <>
            <a href="/blog"><span class="blog-key">esc</span> all posts</a>
            {next && next !== `/blog/${slug}` && <a href={next}><span class="blog-key">o</span> next post</a>}
          </>
        ) : (
          <>
            <button type="button" class="blog-move"><span class="blog-key">arrows</span> move</button>
            <a class="blog-open" href={`/blog/${slug}`}><span class="blog-key">enter</span> open</a>
          </>
        )}
        <button type="button" class="blog-toggle-keys" aria-controls="blog-keys" aria-expanded="false"><span class="blog-key">?</span> help</button>
      </nav>
      <nav class="blog-status" aria-label="Blog windows">
        <a href="/blog">[blog]</a>
        <a class="blog-posts-window" href="/blog">0:posts*{article ? 'Z' : ''}</a>
        <a href="/">1:home</a>
        <span class="blog-status-space"></span>
        <span class="blog-status-right"><span class="blog-active-slug">"{slug}"</span>{' '}<time class="blog-clock"></time></span>
      </nav>
    </div>
  </div>
</Base>

<script>
  import '../scripts/blog-tmux';
</script>
