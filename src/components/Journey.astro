---
// The journey stage. A full-bleed sticky 3D scene behind the chapter text: layers
// at different depths (old illustrations as images, authored SVG inlined), a camera
// that rotates and drifts with scroll, and one figure that morphs and walks through
// it. Docs 07 to 09 in docs/rebuild.
import { timeline, type Layer } from '../data/timeline';

// Raw SVG sources so each path and group can carry its own chapter timeline.
const raw = import.meta.glob('../lib/scenes/*.svg', { eager: true, query: '?raw', import: 'default' }) as Record<string, string>;
const inlineSvg = (stem: string) => {
  const s = raw[`../lib/scenes/${stem}.svg`];
  if (!s) throw new Error(`missing scene ${stem}`);
  // keep the root's presentation attributes (fill, stroke, stroke-width...) so the paths inherit them
  const open = s.match(/<svg([^>]*)>/)?.[1] ?? '';
  const attrs = open.replace(/\s(xmlns|width|height)="[^"]*"/g, '').trim();
  const body = s.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
  return `<svg ${attrs} width="100%" focusable="false">${body}</svg>`;
};

const chapters = timeline.filter((m) => m.scene);
const n = chapters.length;
const tl = (i: number) => `--ch-${i + 1}`;

// Depth: with the camera at PERSPECTIVE px, a plane at z looks smaller by (P - z) / P.
// Scaling it back up around the vanishing point keeps the composition exact at rest,
// so the only thing depth does is parallax when the camera moves.
const PERSPECTIVE = 1400;
const comp = (z: number) => ((PERSPECTIVE - z) / PERSPECTIVE).toFixed(4);
const layerStyle = (L: Layer, i: number) => `--z:${L.z}px; --c:${comp(L.z)}; animation-timeline: ${tl(i)}, ${tl(i)};`;
// --tl lets everything inside the layer (groups with data-motion, paths that draw on) pick up the chapter timeline from CSS.
const animStyle = (L: Layer, i: number) =>
  `left:${L.x}px; top:${L.y}px; width:${L.w}px; --tl: ${tl(i)}; animation-timeline: ${tl(i)}, ${tl(i)};` + (L.range ? ` animation-range: ${L.range};` : '');

const scopeNames = Array.from({ length: 10 }, (_, i) => tl(i)).join(', ');
const fallback =
  `@supports not ((animation-timeline: scroll()) and (animation-range: 0% 100%)) {` +
  chapters.map((_, i) => `.journey[data-chapter="${i}"] .layer[data-i="${i}"]{opacity:1}`).join('') +
  '}';
---

<section class="journey" data-n={n} data-chapter="0" style={`timeline-scope: ${scopeNames}`}>
  <div class="stage" aria-hidden="true">
    <div class="world">
      <div class="cam">
        {chapters.map((m, i) =>
          m.scene!.layers.map((L) => (
            <div class="layer" data-i={i} data-id={L.id} style={layerStyle(L, i)}>
              <div class="anim" data-motion={L.motion ?? 'none'} style={animStyle(L, i)}>
                {L.src ? <img src={L.src} alt="" decoding="async" /> : <Fragment set:html={inlineSvg(L.inline!)} />}
              </div>
            </div>
          )),
        )}
      </div>
    </div>
  </div>

  <div class="wall">
    {chapters.map((m, i) => (
      <article class="ch" id={`ch-${i + 1}`} data-i={i} style={`view-timeline: ${tl(i)} block`}>
        <div class="tx">
          <span class="yr">
            {m.year}
            {m.span && <span class="mut"> {m.span}</span>}
          </span>
          {m.lane && <span class="lane label">{m.lane}</span>}
          <h3>{m.title}</h3>
          <p>{m.body}</p>
          {m.stat && <p class="stat">{m.stat}</p>}
        </div>
      </article>
    ))}
  </div>
</section>

<style is:inline set:html={fallback} />

<style>
  .journey {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    view-timeline-name: --story;
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    width: 100%;
    overflow: clip;
    contain: paint;
    z-index: 0;
    background: var(--bg);
  }
  /* The world is a 1600 by 900 design space, scaled to cover the viewport and anchored bottom right.
     --k is set by the script (max of width/1600 and height/900). */
  .world {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 1600px;
    height: 900px;
    transform-origin: right bottom;
    transform: scale(var(--k, 1));
    perspective: 1400px;
    perspective-origin: 1100px 600px;
  }
  .cam {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    animation-name: cam;
    animation-duration: auto;
    animation-timing-function: linear;
    animation-fill-mode: both;
    animation-timeline: --story;
    animation-range: cover 0% cover 100%;
  }
  @keyframes cam {
    from { transform: rotateY(-7deg) translateX(50px) translateZ(-40px); }
    to { transform: rotateY(7deg) translateX(-50px) translateZ(60px); }
  }
  .layer {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform-origin: 1100px 600px;
    transform: translateZ(var(--z)) scale(var(--c));
    opacity: 0;
    animation-name: fade-in, fade-out;
    animation-duration: auto, auto;
    animation-timing-function: linear, linear;
    /* fade-in fills both ways; fade-out only forwards, or its backwards fill (opacity 1) would win before its range */
    animation-fill-mode: both, forwards;
    animation-range: entry 0% entry 100%, exit 0% exit 100%;
  }
  .anim {
    position: absolute;
    transform-style: preserve-3d;
    transform-origin: center bottom;
    animation-duration: auto, auto;
    animation-timing-function: linear, linear;
    animation-fill-mode: both, both;
    animation-range: entry 0% entry 100%;
  }
  .anim > :global(img),
  .anim > :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    color: #17282f; /* currentColor inside authored ink scenes */
  }
  /* Motions. The same names work on a layer wrapper and on any group inside an inlined SVG. */
  .anim :global([data-motion]) {
    transform-box: fill-box;
    transform-origin: center bottom;
    animation-duration: auto, auto;
    animation-timing-function: linear, linear;
    animation-fill-mode: both, both;
    animation-timeline: var(--tl), var(--tl);
    animation-range: entry 0% entry 100%;
  }
  .anim[data-motion='rise'],
  .anim :global([data-motion='rise']) { animation-name: rise; }
  .anim[data-motion='pop'],
  .anim :global([data-motion='pop']) { animation-name: pop; }
  .anim[data-motion='slide-l'],
  .anim :global([data-motion='slide-l']) { animation-name: slide-l; }
  .anim[data-motion='slide-r'],
  .anim :global([data-motion='slide-r']) { animation-name: slide-r; }
  .anim[data-motion='drift-l'],
  .anim :global([data-motion='drift-l']) { animation-name: drift-l; }
  .anim[data-motion='drift-r'],
  .anim :global([data-motion='drift-r']) { animation-name: drift-r; }
  .anim[data-motion='sail'],
  .anim :global([data-motion='sail']) { animation-name: sail; }
  .anim[data-motion='drop'],
  .anim :global([data-motion='drop']) { animation-name: drop; }
  .anim[data-motion='swing-in'],
  .anim :global([data-motion='swing-in']) { animation-name: swing-in; transform-origin: right center; }
  .anim[data-motion='burst'],
  .anim :global([data-motion='burst']) { animation-name: burst; transform-origin: center; }
  .anim[data-motion='spin'],
  .anim :global([data-motion='spin']) { animation-name: spin; transform-origin: center; }
  .anim[data-motion='shamble'],
  .anim :global([data-motion='shamble']) { animation-name: shamble; }
  .anim[data-motion='flicker'],
  .anim :global([data-motion='flicker']) { animation-name: flicker; }
  .anim[data-motion='pulse'],
  .anim :global([data-motion='pulse']) { animation-name: pulse; transform-origin: center; }
  .anim[data-motion='sway'],
  .anim :global([data-motion='sway']) { animation-name: sway; }
  .anim[data-motion='tilt'],
  .anim :global([data-motion='tilt']) { animation-name: tilt; transform-origin: center; }
  .anim[data-motion='steam'],
  .anim :global([data-motion='steam']) { animation-name: steam; }
  .anim[data-motion='roll'],
  .anim :global([data-motion='roll']) { animation-name: roll; transform-origin: center; }
  .anim[data-motion='dusk'],
  .anim :global([data-motion='dusk']) { animation-name: dusk; }
  .anim[data-motion='fly'],
  .anim :global([data-motion='fly']) {
    offset-path: path('M -160 300 C 300 220 700 120 1000 150 C 1300 180 1500 90 1780 20');
    offset-rotate: auto;
    animation-name: fly;
  }
  @keyframes rise { from { transform: translateY(460px); } to { transform: translateY(0); } }
  @keyframes pop { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes slide-l { from { transform: translateX(-520px); } to { transform: translateX(0); } }
  @keyframes slide-r { from { transform: translateX(520px); } to { transform: translateX(0); } }
  @keyframes drift-l { from { transform: translateX(140px); } to { transform: translateX(-260px); } }
  @keyframes drift-r { from { transform: translateX(-140px); } to { transform: translateX(260px); } }
  @keyframes sail { from { transform: translateX(-90px) rotate(-3deg); } to { transform: translateX(110px) rotate(3deg); } }
  @keyframes drop { from { transform: translateY(-320px); } to { transform: translateY(0); } }
  @keyframes swing-in { from { transform: translateX(560px) translateZ(-300px) rotateY(-75deg); } to { transform: none; } }
  @keyframes fly { from { offset-distance: 0%; } to { offset-distance: 100%; } }
  @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(1440deg); } }
  @keyframes shamble { 0% { transform: translateX(-14px); } 50% { transform: translateX(16px); } 100% { transform: translateX(-10px); } }
  @keyframes flicker {
    0%, 9% { opacity: 1; } 10%, 13% { opacity: 0.15; } 14%, 31% { opacity: 1; } 32%, 34% { opacity: 0.2; }
    35%, 58% { opacity: 1; } 59%, 61% { opacity: 0.1; } 62%, 80% { opacity: 1; } 81%, 84% { opacity: 0.25; } 85%, 100% { opacity: 1; }
  }
  @keyframes pulse { 0%, 100% { transform: scale(1); } 25% { transform: scale(1.3); } 50% { transform: scale(0.95); } 75% { transform: scale(1.25); } }
  @keyframes sway { 0% { transform: rotate(-2.5deg); } 50% { transform: rotate(2.5deg); } 100% { transform: rotate(-1.5deg); } }
  @keyframes tilt { 0% { transform: rotate(-6deg) translateY(0); } 50% { transform: rotate(6deg) translateY(-4px); } 100% { transform: rotate(-4deg) translateY(0); } }
  @keyframes steam { 0% { transform: translateY(10px); opacity: 0; } 30% { opacity: 1; } 100% { transform: translateY(-60px); opacity: 0; } }
  @keyframes roll { from { transform: translateX(-640px) rotate(-900deg); } to { transform: translateX(0) rotate(0deg); } }
  @keyframes dusk { from { transform: translateY(0); } to { transform: translateY(-60px); } }

  /* Inside inlined SVGs, stroked paths with pathLength draw themselves on. */
  .anim :global(path[pathLength]) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation-name: draw;
    animation-duration: auto;
    animation-timing-function: linear;
    animation-fill-mode: both;
    animation-timeline: var(--tl);
    animation-range: entry 60% exit 0%;
  }
  @keyframes draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes burst { from { transform: scale(0); } to { transform: scale(1); } }
  @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes fade-out { from { opacity: 1; } to { opacity: 0; } }

  /* Where scroll timelines are missing, the script's data-chapter picks the layers (rules in the inline style above). */
  @supports not ((animation-timeline: scroll()) and (animation-range: 0% 100%)) {
    .layer, .anim, .cam, .anim :global([data-motion]) { animation-name: none; }
    .layer { transition: opacity 0.4s; }
    .anim :global(path[pathLength]) { animation-name: none; stroke-dashoffset: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cam, .anim, .anim :global([data-motion]) { animation-name: none; }
    .anim :global(path[pathLength]) { animation-name: none; stroke-dashoffset: 0; }
  }

  .wall {
    position: relative;
    z-index: 1;
    margin-top: -100svh;
    padding: 0 var(--pad);
  }
  .ch {
    min-height: 100svh;
    padding-top: 18svh;
  }
  .tx {
    max-width: min(var(--measure), 46ch);
    padding: 18px 28px 18px 0;
    background: color-mix(in srgb, var(--bg) 74%, transparent);
    -webkit-mask: linear-gradient(90deg, #000 86%, transparent);
    mask: linear-gradient(90deg, #000 86%, transparent);
  }
  .yr {
    display: block;
    font-family: var(--f-display);
    font-weight: 300;
    font-size: 54px;
    line-height: 1;
    letter-spacing: -0.035em;
    font-variant-numeric: tabular-nums;
  }
  .yr .mut {
    font-family: var(--f-mono);
    font-size: var(--t-label);
    letter-spacing: 0.09em;
  }
  .lane {
    display: block;
    margin: 10px 0 6px;
  }
  .tx h3 {
    font-size: 22px;
    margin: 0 0 8px;
  }
  .stat {
    margin-top: 10px;
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--mut);
  }

  @media (max-width: 48rem) {
    .ch {
      padding-top: 52svh;
    }
    .tx {
      max-width: none;
      background: color-mix(in srgb, var(--bg) 82%, transparent);
    }
    .yr {
      font-size: 40px;
    }
  }
  @media print {
    .stage {
      display: none;
    }
    .wall {
      margin-top: 0;
    }
    .ch {
      min-height: 0;
      padding-top: 0;
    }
  }
</style>

<script>
  // Two jobs: scale the 1600 by 900 world to cover the viewport, and keep data-chapter
  // current for browsers without CSS scroll timelines (their layers switch on it).
  const root = document.querySelector<HTMLElement>('.journey');
  if (root) {
    const n = Number(root.dataset.n) || 1;
    const stage = root.querySelector<HTMLElement>('.stage')!;
    let last = -1;
    const onScroll = () => {
      const r = root.getBoundingClientRect();
      const total = r.height - innerHeight;
      const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 0;
      const near = Math.round(p * (n - 1));
      if (near !== last) {
        last = near;
        root.dataset.chapter = String(near);
      }
    };
    const fit = () => {
      const k = Math.max(stage.clientWidth / 1600, stage.clientHeight / 900);
      stage.style.setProperty('--k', k.toFixed(4));
      onScroll();
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', fit);
    fit();
  }
</script>
