---
// The journey stage. A full-bleed sticky three.js world behind the chapter text.
// Chapters are the timeline entries; the stage's stations sit on the first chapters
// and the camera holds after the last station. Spec: docs/rebuild/13-journey-real-spec.md.
import { timeline } from '../data/timeline';
import { deliveryUrl } from '../lib/stage/delivery';

const chapters = timeline;
const n = chapters.length;
---

<section class="journey" data-n={n}>
  <div class="stage" aria-hidden="true">
    <img class="opening" src={deliveryUrl('/assets/stage/preview.webp')} width="1440" height="900" alt="" fetchpriority="high" />
    <canvas class="gl"></canvas>
  </div>

  <div class="preparation" hidden>
    <span role="status" aria-live="polite" data-load-status>Loading the journey</span>
    <button type="button" data-skip-stage>Read without 3D</button>
    <button type="button" data-retry-stage hidden>Try 3D again</button>
  </div>

  <div class="wall">
    {chapters.map((m, i) => (
      <article class="ch" id={`ch-${i + 1}`} data-i={i}>
        <div class="tx">
          {i === 0 && Astro.slots.has('hero') ? (
            <slot name="hero" />
          ) : (
            <>
              <span class="yr">
                {m.year}
                {m.span && <span class="mut"> {m.span}</span>}
              </span>
              {m.lane && <span class="lane label">{m.lane}</span>}
              <h3>{m.title}</h3>
              <p>{m.body}</p>
              {m.stat && <p class="stat">{m.stat}</p>}
            </>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .journey {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    width: 100%;
    overflow: clip;
    contain: paint;
    z-index: 0;
    background: var(--bg);
  }
  .gl {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.9s ease;
    position: absolute;
    inset: 0;
  }
  .opening { display: block; width: 100%; height: 100%; object-fit: cover; }
  .preparation {
    position: fixed;
    left: var(--pad);
    right: var(--pad);
    bottom: 24px;
    z-index: 5;
    width: fit-content;
    max-width: calc(100% - 2 * var(--pad));
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 20px;
    padding: 12px 16px;
    color: var(--tx);
    background: var(--bg);
    border: 1px solid var(--tx);
    font-size: 13px;
  }
  .preparation[hidden], .preparation button[hidden] { display: none; }
  .preparation button {
    color: inherit;
    font: inherit;
    border: 0;
    padding: 6px 0;
    background: none;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .preparation button:focus-visible { outline: 2px solid var(--tx); outline-offset: 4px; }
  .journey[data-stage='ready'] .preparation,
  .journey[data-stage='skipped'] .preparation { display: none; }
  @media (prefers-reduced-motion: reduce) { .gl { transition: none; } }
  .gl.on {
    opacity: 1;
  }
  /* the wall lets pointer events through to the stage everywhere except on the text itself */
  .wall {
    position: relative;
    z-index: 1;
    margin-top: -100svh;
    padding: 0 var(--pad);
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .journey:global(.phone-focus) .wall { opacity: 0; }
  .tx {
    pointer-events: auto;
  }
  /* the caption that follows the pointer over a hotspot */
  .stage :global(.veil) { position: absolute; inset: 0; background: #EEF2F5; opacity: 0; pointer-events: none; }
  .stage :global(.cap) {
    position: absolute;
    left: 0;
    top: 0;
    max-width: 34ch;
    padding: 6px 10px;
    font-family: var(--f-mono);
    font-size: 12px;
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: var(--tx);
    background: var(--bg);
    border: 1px solid var(--tx);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.15s, transform 0.15s;
    pointer-events: none;
    z-index: 2;
  }
  .stage :global(.cap.on) {
    opacity: 1;
    transform: none;
  }
  .ch {
    min-height: 100svh;
    padding-top: 18svh;
  }
  /* the tour's cities (Vancouver on) run over the whole of their chapters on the stage, so their cards sit lower in
     their articles: each card comes up the screen while its city is walked, not the city before */
  .ch[data-i='8'],
  .ch[data-i='9'],
  .ch[data-i='10'],
  .ch[data-i='11'] {
    padding-top: 72svh;
  }
  /* the last card runs three chapter lengths: the walk out of the hall and into Floqer's office happens under it (LAST_SPAN in shot.ts) */
  .ch[data-i='3'] {
    min-height: 210svh; /* two chapter lengths: the Android lawn, the boardroom, the 2020 room's door */
  }
  .ch[data-i='12'] {
    min-height: 410svh; /* LAST_SPAN chapter lengths of walk (a chapter is a card, a little over a viewport) and a viewport more, so the stage stays pinned to the end of it */
  }
  @media (min-width: 48.001rem) {
    .ch:first-child {
      padding-top: 13svh;
    }
  }
  .tx {
    pointer-events: auto;
    max-width: min(var(--measure), 46ch);
    padding: 18px 28px 18px 0;
    background: color-mix(in srgb, var(--bg) 74%, transparent);
    -webkit-mask: linear-gradient(90deg, #000 86%, transparent);
    mask: linear-gradient(90deg, #000 86%, transparent);
  }
  .yr {
    display: block;
    font-family: var(--f-display);
    font-weight: 300;
    font-size: 54px;
    line-height: 1;
    letter-spacing: -0.035em;
    font-variant-numeric: tabular-nums;
  }
  .yr .mut {
    font-family: var(--f-mono);
    font-size: var(--t-label);
    letter-spacing: 0.09em;
  }
  .lane {
    display: block;
    margin: 10px 0 6px;
  }
  .tx h3 {
    font-size: 22px;
    margin: 0 0 8px;
  }
  .stat {
    margin-top: 10px;
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--mut);
  }
  @media (max-width: 48rem) {
    .ch {
      padding-top: 52svh;
    }
    .tx {
      max-width: none;
      background: color-mix(in srgb, var(--bg) 82%, transparent);
    }
    .yr {
      font-size: 40px;
    }
  }
  @media print {
    .stage {
      display: none;
    }
    .wall {
      margin-top: 0;
    }
    .ch {
      min-height: 0;
      padding-top: 0;
    }
  }
</style>

<script>
  // Load the renderer only when the journey is within one viewport. three is its own chunk.
  const root = document.querySelector<HTMLElement>('.journey');
  const canvas = root?.querySelector<HTMLCanvasElement>('canvas.gl');
  if (root && canvas) {
    const panel = root.querySelector<HTMLElement>('.preparation')!;
    const skip = root.querySelector<HTMLButtonElement>('[data-skip-stage]')!;
    const retry = root.querySelector<HTMLButtonElement>('[data-retry-stage]')!;
    let dispose: (() => void) | undefined;
    const fail = () => {
      if (root.dataset.stage === 'skipped') return;
      root.dataset.stage = 'error';
      root.querySelector<HTMLElement>('[data-load-status]')!.textContent = 'The 3D journey could not load. You can still read the story.';
      retry.hidden = false;
    };
    skip.addEventListener('click', () => { root.dataset.stage = 'skipped'; dispose?.(); });
    retry.addEventListener('click', () => location.reload());
    new MutationObserver(() => { if (root.dataset.stage === 'error') retry.hidden = false; }).observe(root, { attributes: true, attributeFilter: ['data-stage'] });
    const n = Number(root.dataset.n) || 1;
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        if (root.dataset.stage === 'skipped') return;
        root.dataset.stage = 'loading';
        panel.hidden = false;
        import('../scripts/stage-run.ts')
          .then((m) => { if (root.dataset.stage !== 'skipped') dispose = m.mount(root, canvas, n); })
          .catch((err) => { fail(); console.warn('[journey] stage did not start', err); });
      },
      { rootMargin: '100% 0px' },
    );
    io.observe(root);
  }
</script>
