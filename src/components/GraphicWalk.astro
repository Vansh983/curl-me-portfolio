---
// Renders the graphic home journey with its SVG landmarks and shared text.
import '../styles/global.css';
import { LANDMARKS, AEROPLANE, transitArtwork } from '../lib/phone/artwork';
import { STOPS, PATH_LENGTH, WALK_END, TRANSIT, paragraphsFor } from '../lib/phone/story-path';
import Walker from './phone/Walker.astro';
import LinksPost from './phone/LinksPost.astro';
import AboutText from './AboutText.astro';
import AboutInline from './AboutInline.astro';
import { ABOUT_GREETING, ABOUT_INTRO_PARAGRAPHS } from '../data/about';
const ground = [[-500, TRANSIT.start], [TRANSIT.end, PATH_LENGTH + 500]];
const opening = STOPS[0];
---

<div class="graphic-view" data-graphic-view>
    <div class="journey" id="j">
      <header class="intro">
        <h1>{ABOUT_GREETING}</h1>
        {ABOUT_INTRO_PARAGRAPHS.map(parts => <p><AboutInline parts={parts} /></p>)}
      </header>
      {STOPS.map((stop, i) => (
        <section class="story-block" data-stop={i} id={stop.id} aria-label={stop.name}>
          <AboutText paragraphs={paragraphsFor(stop)} />
        </section>
      ))}
    </div>

    <div class="foot">
      <div class="landscape-viewport">
      <svg id="pic" viewBox="0 0 390 260" preserveAspectRatio="xMidYMax meet" role="img" aria-labelledby="scene-description">
        <title id="scene-description">{STOPS[0].description}</title>
        <g id="landscape">
          <g data-transit set:html={transitArtwork(TRANSIT.start, TRANSIT.end)} />
          {STOPS.slice(1).map(stop => (
            <g data-landmark={stop.id} transform={`translate(${stop.x + 20} ${234 * (1 - stop.scale)}) scale(${stop.scale})`} set:html={LANDMARKS[stop.id]} />
          ))}
          {ground.map(([start, end]) => <g>
            <path d={`M${start} 234H${end}V260H${start}Z`} fill="#cdd2bd" />
            <path d={`M${start} 234H${end}M${start} 252H${end}`} fill="none" stroke="#a8b49b" stroke-width="1" />
            {Array.from({length: Math.floor((end - start) / 48)}, (_, i) => <path d={`M${start + (i + 1) * 48} 234l-7 18`} stroke="#b3bda4" stroke-width="0.65" />)}
          </g>)}
          {/* The patio feet stand on the shared pavement; keep the existing
              ground clipping for every later landmark. */}
          <g data-landmark={opening.id} transform={`translate(${opening.x + 20} 0)`} set:html={LANDMARKS[opening.id]} />
        </g>
        <ellipse id="flight-shadow" cy="235" rx="45" ry="3" fill="#87967b" opacity="0" />
        <g id="flight" opacity="0" aria-hidden="true" set:html={AEROPLANE} />
      </svg>
      </div>
      <Walker />
      <LinksPost />
    </div>
    <script id="path-data" type="application/json" is:inline set:html={JSON.stringify({ stops: STOPS.map(({ paragraphs, ...stop }) => stop), length: PATH_LENGTH, end: WALK_END })} />
    <script>
      import '../scripts/phone-walk';
    </script>
</div>

<style is:global>
  :root {
    --vh: 1vh;
    --walk-ink: #111111;
  }
  .graphic-view {
    --about-ink: var(--walk-ink);
    --about-paper: #e5e8dc;
    --about-fill: #d6d9cc;
    --about-border: #b9bfae;
    --about-focus: var(--walk-ink);
    background: #e5e8dc;
  }
  :root:not([data-home-view='3d']), :root:not([data-home-view='3d']) body {
    margin: 0;
    background: #e5e8dc;
    color: var(--walk-ink);
  }
  body { -webkit-text-size-adjust: 100%; }
  .graphic-view ::selection { color: var(--selection-tx); background: var(--selection-bg); }
  #j {
    position: sticky;
    z-index: 1;
    /* The final line stays clear of the picture and its fade while pinned. */
    padding: 30vh 7.2% calc(30vh + 16px);
    padding: calc(var(--vh) * 30 + env(safe-area-inset-top, 0px)) 7.2% calc(var(--vh) * 30 + var(--links-post-rise, 0px) + 16px);
    max-width: 560px;
    margin: 0;
  }
  .story-block { margin: 0; }
  .graphic-view .intro h1 {
    font-family: 'Bebas Neue Title', sans-serif;
    font-weight: 400;
    font-size: clamp(56px, 18vw, 88px);
    line-height: 1;
    letter-spacing: 0;
    white-space: nowrap;
    margin: 0 0 11px;
  }
  .graphic-view .intro p, .story-block p {
    font-size: 20px;
    line-height: 1.6;
    max-width: 36em;
    margin: 0;
  }
  .graphic-view .intro p { padding: 18px 0; }
  .me:focus-visible {
    outline: 2px solid #365d4c;
    outline-offset: 6px;
    border-radius: 2px;
  }
  .foot {
    display: none;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: 30vh;
    height: calc(var(--vh) * 30);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    z-index: 2;
    pointer-events: none;
    overflow: visible;
    background: #e5e8dc;
  }
  .foot::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: calc(var(--links-post-rise, 0px) + 16px);
    background: linear-gradient(to bottom, transparent, #e5e8dc 16px);
    pointer-events: none;
  }
  .landscape-viewport { width: 100%; height: 100%; overflow: hidden; }
  .walk-ready .foot { display: block; }
  #pic { display: block; width: 100%; height: 100%; overflow: visible; }
  .me {
    position: absolute;
    border: 0;
    padding: 0;
    margin: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    pointer-events: auto;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .me::before { content: ''; position: absolute; top: -8px; right: -8px; bottom: -8px; left: -8px; }
  .sprite { display: block; width: 100%; height: 100%; overflow: visible; }
  .legs { display: none; }
  [data-step="idle"] .legs-0,
  [data-step="0"] .legs-1,
  [data-step="1"] .legs-2,
  [data-step="2"] .legs-1,
  [data-step="3"] .legs-3 { display: block; }
  [data-direction="back"] .sprite { transform: scaleX(-1); }
  .me:disabled { pointer-events: none; }
  .me.jump { animation: jump 720ms cubic-bezier(0.2, 0.65, 0.3, 1); }
  [data-landmark='toronto-cafe'] .toronto-tram {
    transform: translateX(344px);
    animation: toronto-tram 8s infinite;
  }
  @keyframes toronto-tram {
    0% { transform: translateX(480px); animation-timing-function: ease-out; }
    30% { transform: translateX(344px); }
    48% { transform: translateX(344px); animation-timing-function: ease-in; }
    100% { transform: translateX(90px); }
  }
  [data-landmark='toronto-cafe'] .toronto-go-train {
    transform: translateX(344px);
    animation: toronto-go-train 10s linear infinite;
  }
  @keyframes toronto-go-train {
    from { transform: translateX(200px); }
    to { transform: translateX(670px); }
  }
  [data-landmark='toronto-cafe'] .toronto-cloud { animation: toronto-cloud 10s ease-in-out -1s infinite; }
  [data-landmark='toronto-cafe'] .toronto-cloud.toronto-slow { animation-duration: 12s; animation-delay: -3.4s; }
  @keyframes toronto-cloud {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(26px); }
  }
  [data-landmark='toronto-cafe'] .toronto-blink { animation: toronto-blink 2.4s steps(1) infinite; }
  @keyframes toronto-blink { 50% { opacity: .15; } }
  [data-landmark='delhi'] .delhi-code { animation: delhi-code 6s linear infinite; }
  @keyframes delhi-code {
    0%, 10% { transform: translateY(0); opacity: 1; }
    70% { transform: translateY(-8px); opacity: 1; }
    85% { transform: translateY(-8px); opacity: 0; }
    86% { transform: translateY(0); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }
  [data-landmark='delhi'] .delhi-sun { animation: delhi-sun 9s ease-in-out -1.1s infinite; }
  @keyframes delhi-sun {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-6px, 4px); }
  }
  [data-landmark='delhi'] .delhi-console-light { animation: delhi-console-light 3.4s ease-in-out -.8s infinite; }
  @keyframes delhi-console-light {
    0%, 100% { opacity: 1; }
    50% { opacity: .35; }
  }
  [data-landmark='google'] .google-tree {
    transform-origin: 0px 79px;
    animation: google-tree 7s ease-in-out -.7s infinite;
  }
  @keyframes google-tree {
    0%, 100% { transform: rotate(0); }
    25% { transform: rotate(2deg); }
    75% { transform: rotate(-2deg); }
  }
  /* A ten-stride walk across the frontage, independent of the scroll walker. */
  [data-landmark='university'] .uni-passer {
    animation: uni-pass-east 9.5s linear var(--uni-delay) infinite;
  }
  [data-landmark='university'] .uni-east-one {
    --uni-delay: -1s;
    --uni-gait: -.1s;
    transform: translate(220px, 232px);
  }
  [data-landmark='university'] .uni-west {
    --uni-delay: -3.1s;
    --uni-gait: -.35s;
    transform: translate(330px, 232px);
    animation-name: uni-pass-west;
  }
  [data-landmark='university'] .uni-east-two {
    --uni-delay: -6.2s;
    --uni-gait: -.65s;
    transform: translate(535px, 232px);
  }
  @keyframes uni-pass-east {
    0% { transform: translate(180px, 232px); opacity: 0; }
    4%, 96% { opacity: 1; }
    100% { transform: translate(550px, 232px); opacity: 0; }
  }
  @keyframes uni-pass-west {
    0% { transform: translate(550px, 232px); opacity: 0; }
    4%, 96% { opacity: 1; }
    100% { transform: translate(180px, 232px); opacity: 0; }
  }
  [data-landmark='university'] .uni-body {
    animation: uni-walk-rise .95s ease-in-out var(--uni-gait) infinite;
  }
  [data-landmark='university'] .uni-thigh,
  [data-landmark='university'] .uni-shin,
  [data-landmark='university'] .uni-arm { transform-origin: 0 0; }
  [data-landmark='university'] .uni-thigh {
    transform: rotate(3deg);
    animation: uni-stride .95s linear var(--uni-gait) infinite;
  }
  [data-landmark='university'] .uni-shin {
    animation: uni-knee .95s ease-in-out var(--uni-gait) infinite;
  }
  [data-landmark='university'] .uni-arm {
    transform: rotate(-6deg);
    animation: uni-arm-swing .95s ease-in-out var(--uni-gait) infinite;
  }
  [data-landmark='university'] .uni-far {
    animation-delay: calc(var(--uni-gait) - .475s);
  }
  [data-landmark='university'] .uni-thigh.uni-far { transform: rotate(-3deg); }
  [data-landmark='university'] .uni-arm.uni-far { transform: rotate(8deg); }
  @keyframes uni-walk-rise {
    0%, 50%, 100% { transform: translateY(0); }
    25%, 75% { transform: translateY(-2px); }
  }
  @keyframes uni-stride {
    0%, 100% { transform: rotate(-24deg); }
    25% { transform: rotate(0); }
    50% { transform: rotate(24deg); }
    75% { transform: rotate(-10deg); }
  }
  @keyframes uni-knee {
    0%, 50%, 100% { transform: rotate(0); }
    75% { transform: rotate(55deg); }
  }
  @keyframes uni-arm-swing {
    0%, 100% { transform: rotate(22deg); }
    50% { transform: rotate(-22deg); }
  }
  /* ShiftKey A1 keeps the mock's independent 8–12 second loops. */
  .sk-slide{opacity:0;animation:sk-slide-cycle 12s linear infinite}.sk-slide-ai{opacity:1}.sk-slide-cloud{animation-delay:-9s}.sk-slide-code{animation-delay:-6s}.sk-slide-git{animation-delay:-3s}
  @keyframes sk-slide-cycle{0%,20%,100%{opacity:1}25%,95%{opacity:0}}
  .sk-student-head{transform-origin:0 7px;animation:sk-head-turn 10.7s ease-in-out var(--sk-lag,0s) infinite}@keyframes sk-head-turn{0%,28%,58%,100%{transform:rotate(0)}38%,47%{transform:rotate(-5deg)}78%,86%{transform:rotate(3deg)}}
  .sk-typing{animation:sk-typing 9.6s ease-in-out var(--sk-lag,0s) infinite}@keyframes sk-typing{0%,12%,22%,32%,58%,68%,78%,100%{transform:translateY(0)}17%,27%,63%,73%{transform:translateY(-1.1px)}}
  .sk-raised-hand{transform-origin:0 0;animation:sk-hand-up 10.9s ease-in-out infinite}.sk-student:nth-child(2n) .sk-raised-hand{animation-delay:-3s}.sk-student:nth-child(3n) .sk-raised-hand{animation-delay:-6s}
  @keyframes sk-hand-up{0%,14%,88%,100%{transform:rotate(0)}27%,68%{transform:rotate(160deg)}42%,48%{transform:rotate(153deg)}}
  .sk-screen-glow{opacity:.15;animation:sk-screen-glow 8.7s ease-in-out var(--sk-lag,0s) infinite}@keyframes sk-screen-glow{0%,100%{opacity:.12}35%,62%{opacity:.35}}
  #me[data-activity="teach"] .held-pointer{transform-origin:11px 10px;animation:sk-point 12s ease-in-out infinite}@keyframes sk-point{0%,15%,100%{transform:rotate(0)}28%,44%{transform:rotate(-6deg)}62%,78%{transform:rotate(4deg)}}
  .sk-steam{animation:sk-steam 10s ease-in-out infinite}@keyframes sk-steam{0%,100%{opacity:.4;transform:translateY(0)}50%{opacity:.9;transform:translateY(-3px)}}
  .sk-rain{animation:sk-rain 8.8s linear infinite}@keyframes sk-rain{0%{transform:translate(0,-10px);opacity:0}10%,90%{opacity:1}100%{transform:translate(-15px,35px);opacity:0}}
  .sk-light-breathe{animation:sk-light 11s ease-in-out infinite}@keyframes sk-light{0%,100%{opacity:.65}50%{opacity:1}}
  .sk-record-light{animation:sk-record 8s ease-in-out infinite}@keyframes sk-record{0%,30%,60%,100%{opacity:1}15%,45%,80%{opacity:.3}}
  .sk-demo-line{transform-origin:35px 0;animation:sk-code 12s ease-out var(--sk-lag,0s) infinite}@keyframes sk-code{0%,15%,100%{opacity:.45;transform:scaleX(.4)}35%,85%{opacity:1;transform:scaleX(1)}}
  .sk-demo-cursor{animation:sk-cursor 8s ease-in-out infinite}@keyframes sk-cursor{0%,20%,40%,60%,80%,100%{opacity:1}10%,30%,50%,70%,90%{opacity:0}}
  .sk-merge-check{animation:sk-merge 12s ease-in-out var(--sk-lag,0s) infinite}@keyframes sk-merge{0%,20%,100%{opacity:.2}42%,85%{opacity:1}}
  .sk-late-student{animation:sk-arrive 12s ease-in-out infinite}@keyframes sk-arrive{0%,5%{opacity:0;transform:translateX(8px)}13%{opacity:1;transform:translateX(5px)}43%,76%{opacity:1;transform:translateX(-23px)}88%,100%{opacity:0;transform:translateX(-23px)}}
  .sk-side-door{transform-origin:726px 114px;animation:sk-door 12s ease-in-out infinite}@keyframes sk-door{0%,6%,55%,100%{transform:scaleX(1)}18%,40%{transform:scaleX(.14)}}
  .sk-arrival-leg,.sk-arrival-shin,.sk-arrival-arm{transform-origin:0 0;animation:sk-gait 12s ease-in-out infinite}.sk-arrival-leg.sk-far{animation-name:sk-gait-back}.sk-arrival-shin{animation-name:sk-knee}.sk-arrival-shin.sk-far{animation-name:sk-knee-back}.sk-arrival-arm{transform-origin:0 14px;animation-name:sk-gait-back}
  @keyframes sk-gait{0%,10%,43%,100%{transform:rotate(0)}15%,27%,39%{transform:rotate(18deg)}21%,33%{transform:rotate(-18deg)}}
  @keyframes sk-gait-back{0%,10%,43%,100%{transform:rotate(0)}15%,27%,39%{transform:rotate(-18deg)}21%,33%{transform:rotate(18deg)}}
  @keyframes sk-knee{0%,10%,21%,33%,43%,100%{transform:rotate(0)}15%,27%,39%{transform:rotate(-23deg)}}
  @keyframes sk-knee-back{0%,10%,15%,27%,39%,43%,100%{transform:rotate(0)}21%,33%{transform:rotate(-23deg)}}
  [data-landmark='webcube'] { --wc-loop: 12s; }
  [data-landmark='webcube'] .wc-sky { animation: wc-sky var(--wc-loop) ease-in-out infinite; }
  [data-landmark='webcube'] .wc-city { animation: wc-city var(--wc-loop) ease-in-out infinite; }
  [data-landmark='webcube'] .wc-sun { animation: wc-sun var(--wc-loop) ease-in-out infinite; }
  [data-landmark='webcube'] .wc-moon { opacity: 0; animation: wc-moon var(--wc-loop) ease-in-out infinite; }
  [data-landmark='webcube'] .wc-night { opacity: 0; animation: wc-night var(--wc-loop) ease-in-out infinite; }
  [data-landmark='webcube'] .wc-screen { opacity: 0; animation: wc-screen var(--wc-loop) linear infinite; }
  [data-landmark='webcube'] .wc-screen-meeting { opacity: 1; }
  [data-landmark='webcube'] .wc-screen-code { animation-delay: -10s; }
  [data-landmark='webcube'] .wc-screen-page { animation-delay: -8s; }
  [data-landmark='webcube'] .wc-screen-small { animation-delay: -6s; }
  [data-landmark='webcube'] .wc-screen-board { animation-delay: -4s; }
  [data-landmark='webcube'] .wc-screen-sheet { animation-delay: -2s; }
  @keyframes wc-sky {
    0%, 15%, 100% { fill: #c5d8d4; }
    30% { fill: #d8b49a; }
    46%, 72% { fill: #253735; }
    86% { fill: #b9988b; }
  }
  @keyframes wc-city {
    0%, 15%, 100% { fill: #a7bab4; }
    30%, 86% { fill: #7f908b; }
    46%, 72% { fill: #45594e; }
  }
  @keyframes wc-sun {
    0%, 12%, 100% { transform: translate(0, 0); opacity: 1; }
    32% { transform: translate(-5px, 40px); opacity: 1; }
    41%, 74% { transform: translate(-7px, 78px); opacity: 0; }
    79% { transform: translate(8px, 78px); opacity: 0; }
    88% { transform: translate(5px, 38px); opacity: 1; }
  }
  @keyframes wc-moon {
    0%, 32%, 92%, 100% { transform: translate(0, 28px); opacity: 0; }
    46%, 70% { transform: translate(0, 0); opacity: 1; }
    82% { transform: translate(-5px, 10px); opacity: .45; }
  }
  @keyframes wc-night {
    0%, 30%, 96%, 100% { opacity: 0; }
    46%, 74% { opacity: 1; }
    86% { opacity: .35; }
  }
  @keyframes wc-screen {
    0%, 13.333% { opacity: 1; }
    16.667%, 96.667% { opacity: 0; }
    100% { opacity: 1; }
  }
  @keyframes jump {
    0%, 100% { translate: 0 0; }
    43% { translate: 0 -28px; }
  }
  /* Transform fallback for older in-app browsers. */
  @supports not (translate: 0 0) {
    @keyframes jump {
      0%, 100% { transform: translateY(0); }
      43% { transform: translateY(-28px); }
    }
  }
  @media (min-width: 1025px) {
    /* Match TextJourney's laptop text while keeping the walk's bottom padding. */
    :root[data-laptop='true'] #j {
      font-family: var(--f-body);
      font-weight: 300;
      font-size: 22px;
      line-height: 1.5;
      width: 50vw;
      max-width: calc(22.5em + var(--pad) + 1em);
      padding-top: 12svh;
      padding-left: var(--pad);
      padding-right: 1em;
    }
    :root[data-laptop='true'] .graphic-view .intro { padding-bottom: .75em; }
    :root[data-laptop='true'] .graphic-view .intro h1 { font-size: 88px; margin-bottom: 12px; }
    :root[data-laptop='true'] .graphic-view .intro p,
    :root[data-laptop='true'] .graphic-view .about-paragraph > p {
      font-size: inherit;
      line-height: inherit;
      padding: 0;
    }
    :root[data-laptop='true'] .graphic-view .intro p + p { margin-top: 1.5em; }
    :root[data-laptop='true'] .graphic-view .about-paragraph { padding: .75em 0; }
    :root[data-laptop='true'] .graphic-view .about-tag { padding: 0 .45em; border-radius: 1em; }
  }
  :root:not([data-laptop='true']) #j {
      margin: 0 auto;
      padding-top: 7vh;
      padding-top: calc(var(--vh) * 7 + env(safe-area-inset-top, 0px));
  }
  @media (max-width: 350px) {
    #j { padding-left: 6.5%; padding-right: 6.5%; }
    .graphic-view .intro p, .story-block p { font-size: 19px; line-height: 1.6; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-landmark='shiftkey'] g, #me[data-activity="teach"] .held-pointer { animation: none !important; }
    .sk-slide { opacity: 0; }
    .sk-slide-ai { opacity: 1; }
    .sk-screen-glow { opacity: .2; }
    .sk-late-student { transform: translateX(-23px); opacity: 1; }
    .sk-rain { opacity: .75; }
    .sk-merge-check { opacity: 1; }
    .me.jump { animation: none; }
    [data-landmark='toronto-cafe'] .toronto-tram,
    [data-landmark='toronto-cafe'] .toronto-go-train,
    [data-landmark='toronto-cafe'] .toronto-cloud,
    [data-landmark='toronto-cafe'] .toronto-blink { animation: none; }
    [data-landmark='delhi'] .delhi-code,
    [data-landmark='delhi'] .delhi-sun,
    [data-landmark='delhi'] .delhi-console-light,
    [data-landmark='google'] .google-tree { animation: none; }
    [data-landmark='university'] .uni-passer,
    [data-landmark='university'] .uni-body,
    [data-landmark='university'] .uni-thigh,
    [data-landmark='university'] .uni-shin,
    [data-landmark='university'] .uni-arm { animation: none; }
    [data-landmark='webcube'] g { animation: none !important; }
    [data-landmark='webcube'] .wc-sky { fill: #c5d8d4; }
    [data-landmark='webcube'] .wc-city { fill: #a7bab4; }
    [data-landmark='webcube'] .wc-sun { opacity: 1; transform: none; }
    [data-landmark='webcube'] .wc-moon, [data-landmark='webcube'] .wc-night, [data-landmark='webcube'] .wc-screen { opacity: 0; }
    [data-landmark='webcube'] .wc-screen-meeting { opacity: 1; }
  }
</style>
