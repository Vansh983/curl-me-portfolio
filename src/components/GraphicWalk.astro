  /* Volta community keeps the approved mock's 8–12 second loops. */
  :root[data-place='collect'] #me[data-activity='present'] .held-mic > :not(:last-child) { transform-origin: 11px 10px; animation: collect-mic 10s ease-in-out infinite; }
  :root[data-place='collect'] #me[data-activity='present'] .held-mic > :last-child { transform-origin: 3px 10px; animation: collect-welcome 10s ease-in-out infinite; }
  @keyframes collect-mic { 0%,18%,100% { transform: rotate(0); } 30%,66% { transform: rotate(-9deg); } }
  @keyframes collect-welcome { 0%,15%,73%,100% { transform: rotate(0); } 30%,48% { transform: rotate(28deg); } 37%,43% { transform: rotate(18deg); } }
  .collect-head{transform-origin:0 7px;animation:collect-head-turn 10s ease-in-out var(--collect-lag,0s) infinite}
  @keyframes collect-head-turn{0%,20%,58%,100%{transform:rotate(0)}33%,43%{transform:rotate(-7deg)}74%,85%{transform:rotate(4deg)}}
  .collect-typing{animation:collect-typing 8s ease-in-out var(--collect-lag,0s) infinite}@keyframes collect-typing{0%,12%,22%,32%,58%,68%,78%,100%{transform:translateY(0)}17%,27%,63%,73%{transform:translateY(-1.3px)}}
  .collect-gesture{transform-origin:0 0;animation:collect-gesture 10s ease-in-out infinite}@keyframes collect-gesture{0%,15%,82%,100%{transform:rotate(0)}32%,62%{transform:rotate(125deg)}45%,50%{transform:rotate(115deg)}}
  .collect-dusk{animation:collect-dusk 12s ease-in-out infinite}@keyframes collect-dusk{0%,100%{opacity:0}65%,89%{opacity:.68}}
  .collect-city-lights{animation:collect-city-lights 12s ease-in-out infinite}@keyframes collect-city-lights{0%,18%,100%{opacity:.1}58%,88%{opacity:1}}
  .collect-ring-glow{animation:collect-light 12s ease-in-out infinite}@keyframes collect-light{0%,100%{opacity:.65}55%,89%{opacity:1}}
  .collect-ferry{animation:collect-ferry 12s linear infinite}@keyframes collect-ferry{0%{transform:translateX(-34px)}100%{transform:translateX(76px)}}
  .collect-ripples{animation:collect-ripples 8s ease-in-out infinite}@keyframes collect-ripples{0%,100%{opacity:.35;transform:translateX(-3px)}50%{opacity:.85;transform:translateX(4px)}}
  .collect-cloud{animation:collect-cloud 12s ease-in-out infinite}@keyframes collect-cloud{0%,100%{transform:translateX(-3px)}50%{transform:translateX(12px)}}
  .collect-steam{animation:collect-steam 9s ease-in-out infinite}@keyframes collect-steam{0%,100%{opacity:.35;transform:translateY(0)}50%{opacity:.9;transform:translateY(-4px)}}
