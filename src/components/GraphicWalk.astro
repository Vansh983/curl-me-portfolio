  .sk-rain{animation:sk-rain 8.8s linear infinite}@keyframes sk-rain{0%{transform:translate(0,-10px);opacity:0}10%,90%{opacity:1}100%{transform:translate(-15px,35px);opacity:0}}
  .sk-light-breathe{animation:sk-light 11s ease-in-out infinite}@keyframes sk-light{0%,100%{opacity:.65}50%{opacity:1}}
