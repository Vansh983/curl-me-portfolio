---
// Renders the shared home paragraphs and their expandable cards.
import { ABOUT_ROWS, type AboutParagraph } from '../data/about';
import AboutInline from './AboutInline.astro';

type Props = { paragraphs: readonly AboutParagraph[]; prefix?: string };
const { paragraphs, prefix = 'about' } = Astro.props;
---

{paragraphs.map(paragraph => (
  <div class="about-paragraph" data-about-paragraph={paragraph.id}>
    <p><AboutInline parts={paragraph.parts} prefix={prefix} /></p>
    {paragraph.parts.flatMap(part => part.tag ? [part.tag] : []).map(tag => {
      const row = ABOUT_ROWS[tag];
      return (
        <div class="about-row" id={`${prefix}-row-${tag}`} data-about-row hidden>
          <div class="about-cards" role="region" aria-labelledby={`${prefix}-tag-${tag}`} tabindex="0">
            <ul>
              {row.cards.map(card => <li class:list={['about-card', row.shape, { photo: !!card.image }]}>
                {card.image ? <img src={card.image} alt={card.alt} width="1280" height="960" loading="lazy" /> : card.name}
              </li>)}
            </ul>
          </div>
          {row.note && <p class="about-note">{row.note}</p>}
        </div>
      );
    })}
  </div>
))}

<style>
  .about-paragraph { padding: 18px 0; }
  .about-cards:focus {
    outline: 2px solid var(--about-focus, var(--tx));
    outline-offset: 3px;
  }
  .about-cards:focus:not(:focus-visible) { outline: none; }
  .about-row { margin: 8px 0 14px; }
  .about-row[hidden] { display: none; }
  .about-cards {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--about-border, var(--rule)) transparent;
  }
  .about-cards ul { display: flex; list-style: none; margin: 0; padding: 0 0 4px; }
  .about-card {
    flex: 0 0 auto;
    display: flex;
    align-items: flex-end;
    padding: 6px;
    border: 1px solid var(--about-border, var(--rule));
    border-radius: 6px;
    background: var(--about-fill, var(--raise));
    font-size: 11px;
    line-height: 1.4;
    overflow: hidden;
  }
  .about-card + .about-card { margin-left: 8px; }
  .poster { width: 78px; height: 112px; }
  .wide { width: 136px; height: 86px; }
  .square { width: 96px; height: 96px; }
  .photo { padding: 0; width: 160px; height: 120px; }
  .photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .about-row .about-note { font-size: 13px; line-height: 1.6; margin: 6px 0 0; }
</style>

