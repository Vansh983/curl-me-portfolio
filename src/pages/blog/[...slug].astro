---
import BlogTmux from '../../layouts/BlogTmux.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { iso } from '../../lib/date';
import { readingTime } from '../../lib/blog/reading-time';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.id.localeCompare(b.id)
  );
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      index,
      prev: `/blog/${posts[(index - 1 + posts.length) % posts.length].id}`,
      prevTitle: posts[(index - 1 + posts.length) % posts.length].data.title,
      next: `/blog/${posts[(index + 1) % posts.length].id}`,
      nextTitle: posts[(index + 1) % posts.length].data.title,
    },
  }));
}

type Props = { post: CollectionEntry<'blog'>; index: number; prev: string; prevTitle: string; next: string; nextTitle: string };
const { post, index, prev, prevTitle, next, nextTitle } = Astro.props;
const { Content } = await render(post);
---

<BlogTmux
  title={post.data.title}
  description={post.data.description}
  slug={post.id}
  {next}
  article={{
    published: iso(post.data.pubDate),
    updated: post.data.updatedDate ? iso(post.data.updatedDate) : undefined,
  }}
>
  <article class="blog-pane blog-zoom">
    <span class="blog-pane-label">{index}: {post.id}</span>
    <a class="blog-back" href="/blog">← all posts</a>
    <div class="blog-pane-meta">
      <time datetime={iso(post.data.pubDate)}>{iso(post.data.pubDate)}</time> · {readingTime(post.body)} min read
      {post.data.updatedDate && <span> &middot; updated <time datetime={iso(post.data.updatedDate)}>{iso(post.data.updatedDate)}</time></span>}
      {post.data.tags.length > 0 && <span> &middot; {post.data.tags.join(', ')}</span>}
    </div>
    <h1>{post.data.title}</h1>
    <div class="blog-prose">
      <Content />
    </div>
    <nav class="blog-post-nav" aria-label="Post navigation">
      {prev !== `/blog/${post.id}` && (
        <a class="plain" href={prev} title={prevTitle}>
          <span class="blog-post-nav-label">back</span>
          <span class="blog-post-nav-title">
            <span aria-hidden="true">←</span>
            <span>{prevTitle}</span>
          </span>
        </a>
      )}
      {next !== `/blog/${post.id}` && (
        <a class="plain" href={next} title={nextTitle}>
          <span class="blog-post-nav-label">next</span>
          <span class="blog-post-nav-title">
            <span>{nextTitle}</span>
            <span aria-hidden="true">→</span>
          </span>
        </a>
      )}
    </nav>
  </article>
</BlogTmux>
