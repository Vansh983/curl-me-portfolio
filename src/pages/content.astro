---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
import { lead, chapters } from '../data/story';

// The whole story as plain text: a name, a line, and paragraphs. No timeline,
// no gutters, no figures. The words live in src/data/story.ts.
---

<Base title="Content" description={lead.now} noindex>
  <article class="story">
    <h1 class="block">{profile.name}</h1>
    <p class="role">{lead.role}</p>

    <section>
      <p>{lead.now}</p>
    </section>

    {
      chapters.map((c) => (
        <section id={c.id}>
          {c.paras.map((p) => <p>{p}</p>)}
        </section>
      ))
    }

    <p class="reach">
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
      {profile.links.map((l) => <a href={l.href}>{l.handle}</a>)}
    </p>
  </article>
</Base>

<style>
  .story {
    font-size: 17px;
  }
  .role {
    margin-top: 14px;
    color: var(--mut);
  }
  section {
    margin-top: 44px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .reach {
    margin-top: 60px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-family: var(--f-mono);
    font-size: var(--t-label);
    letter-spacing: 0.06em;
  }
</style>
