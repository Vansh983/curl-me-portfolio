---
// The phone journey: the words up top, one continuous text; the bottom two
// fifths of the screen a side scroller, him walking right through the places
// of the story as the page scrolls, a door between each. The places are
// src/lib/phone/walk.ts. He is twelve colours of pixels, four frames.
//
// Built for the phones people open links on, old ones and the Instagram and
// LinkedIn browsers: window scroll, one frame per scroll event, transforms
// only, no WebGL, no scroll-driven CSS, nothing newer than 2019 WebKit
// without a fallback. Without JavaScript the words stand alone.
import '../../styles/global.css';
import { profile } from '../../data/profile';
import { lead, openings, chapters } from '../../data/story';
import { PHASES } from '../../lib/phone/walk';

type Words = { paras: string[] };
const byId = new Map<string, Words>();
byId.set('now', { paras: [lead.now] });
for (const c of [...openings, ...chapters]) byId.set(c.id, c);
const words = PHASES.map((p) => {
  const w = byId.get(p.chapter);
  if (!w) throw new Error(`no words for phase ${p.id}`);
  return w;
});

// him, 14 by 20, drawn as one box-shadow per pixel
const INK: Record<string, string> = { h: '#1A1410', s: '#C99A6B', k: '#1A1410', o: '#2B2B2B', j: '#2F3A55', w: '#EDEDED' };
const head = [
  '....hhhhhh....',
  '...hhhhhhhh...',
  '...hhhhhhhh...',
  '...hhssssss...',
  '...ssskssks...',
  '...ssssssss...',
  '....ssssss....',
  '....oooooo....',
  '...oooooooo...',
  '..oooooooooo..',
  '..soooooooos..',
  '...oooooooo...',
  '...oooooooo...',
  '....jjjjjj....',
  '....jjjjjj....',
];
const legs = {
  stand: ['....jj..jj....', '....jj..jj....', '....jj..jj....', '....jj..jj....', '...www..www...'],
  mid: ['....jj..jj....', '...jj....jj...', '...jj....jj...', '...jj....jj...', '..www....www..'],
  step: ['...jjj..jjj...', '..jjj....jjj..', '..jj......jj..', '.jj........jj.', 'www........www'],
};
const mirror = (rows: string[]) => rows.map((r) => r.split('').reverse().join(''));
const shadow = (rows: string[]) => {
  const out: string[] = [];
  rows.forEach((row, y) => {
    if (row.length !== 14) throw new Error(`row ${y} is ${row.length} wide`);
    row.split('').forEach((ch, x) => {
      if (ch !== '.') out.push(`${x}px ${y}px 0 0 ${INK[ch]}`);
    });
  });
  return out.join(',');
};
const frames = {
  idle: shadow([...head, ...legs.stand]),
  f0: shadow([...head, ...legs.mid]),
  f1: shadow([...head, ...legs.step]),
  f2: shadow([...head, ...legs.mid]),
  f3: shadow([...head, ...mirror(legs.step)]),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0a0a0a" />
    <title>The walk | Vansh Sood</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/space-grotesk.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter.woff2" crossorigin />
    <script is:inline>
      if ('noModule' in HTMLScriptElement.prototype) document.documentElement.className += ' js';
    </script>
  </head>
  <body>
    <main class="j" id="j">
      {
        words.map((w, i) => (
          <section class="tx" data-s={i}>
            {i === 0 && <h1>{profile.name}</h1>}
            {i === 0 && <p class="role">{lead.role}</p>}
            {w.paras.map((p) => (
              <p>{p}</p>
            ))}
          </section>
        ))
      }
      <footer class="end">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        {profile.links.map((l) => <a href={l.href}>{l.handle}</a>)}
      </footer>
    </main>

    <div class="strip" id="strip" aria-hidden="true">
      <div class="layer" data-l="far"></div>
      <div class="layer" data-l="mid"></div>
      <div class="layer" data-l="near"></div>
      <div class="me idle" id="me"><i class="px"></i></div>
    </div>

    <script>
      import { PHASES, PARALLAX, GROUND } from '../../lib/phone/walk';
      import type { Layer, Prop } from '../../lib/phone/walk';

      const N = PHASES.length;
      const SPEED = 1.1; // world px per page px
      const root = document.documentElement;
      const strip = document.getElementById('strip')!;
      const me = document.getElementById('me')!;
      const layers: Record<Layer, HTMLElement> = {
        far: strip.querySelector('[data-l="far"]')!,
        mid: strip.querySelector('[data-l="mid"]')!,
        near: strip.querySelector('[data-l="near"]')!,
      };
      const texts = Array.from(document.querySelectorAll<HTMLElement>('.tx'));
      const hex = (c: string): [number, number, number] => [parseInt(c.slice(1, 3), 16), parseInt(c.slice(3, 5), 16), parseInt(c.slice(5, 7), 16)];
      const skies = PHASES.map((p) => hex(p.sky));

      let vh = innerHeight, vw = innerWidth, W = 390, CX = 110, ticking = false;
      // s[k]: the page scroll at which he enters phase k; b[k]: where phase k begins in the world
      // (near-layer px). A short chapter still gets MIN px of world: he walks faster through it.
      const MIN = 560;
      const s: number[] = [];
      const b: number[] = [];

      // the world ends where he stands at the page's end, ten px past the last place's edge
      const origin = (k: number, pl: number) => (k === 0 ? 0 : CX + ((k === N ? b[N] + CX + 10 : b[k]) - CX) * pl);

      const place = (seg: HTMLElement, p: Prop, x: number) => {
        const el = document.createElement('i');
        el.className = 'p' + (p.s ? ' s-' + p.s : '');
        const st = el.style;
        st.left = x + 'px';
        st.bottom = GROUND + p.y + 'px';
        st.width = p.w + 'px';
        st.height = p.h + 'px';
        st.backgroundColor = p.c;
        st.color = p.c;
        if (p.r) st.borderRadius = p.r + '%';
        if (p.o !== undefined) st.opacity = String(p.o);
        seg.appendChild(el);
      };

      // the world is built once per width, from where the chapters stand on the page: each phase a
      // clipped segment in each layer, so one place's far hills never show behind the next
      const build = () => {
        for (const k of Object.keys(layers) as Layer[]) layers[k].innerHTML = '';
        for (let k = 0; k < N; k++) {
          const ph = PHASES[k];
          for (const L of ['far', 'mid', 'near'] as Layer[]) {
            const pl = PARALLAX[L];
            const o = origin(k, pl), span = origin(k + 1, pl) - o;
            const seg = document.createElement('div');
            seg.className = 'seg';
            seg.style.left = o + 'px';
            seg.style.width = span + (k === N - 1 ? W : 0) + 'px';
            layers[L].appendChild(seg);
            if (L === 'near') {
              if (ph.wall) place(seg, { x: 0, y: -GROUND, w: span + W, h: 2000, c: ph.sky }, 0);
              place(seg, { x: 0, y: -GROUND, w: span + (k === N - 1 ? W : 0), h: GROUND, c: ph.ground }, 0);
            }
            for (const p of ph[L] || []) {
              const x0 = p.x < 0 ? span + p.x : p.x; // a negative x stands from the end of the place
              if (p.every) {
                for (let x = x0; x < span - 20; x += p.every) place(seg, p, x);
              } else place(seg, p, x0);
            }
            // the door at the end of a place, the way into the next
            if (L === 'near' && k < N - 1) place(seg, { x: 0, y: 0, w: 44, h: 92, c: '#1E1A18', s: 'door' }, span - 60);
          }
        }
      };

      const measure = () => {
        vh = innerHeight;
        root.style.setProperty('--vh', vh / 100 + 'px');
        W = root.clientWidth;
        CX = Math.round(W * 0.3);
        me.style.left = CX - 28 + 'px';
        s.length = 0;
        b.length = 0;
        s.push(0);
        b.push(0);
        for (let k = 1; k < N; k++) {
          s.push(Math.max(s[k - 1] + 1, texts[k].offsetTop - vh * 0.35));
          b.push(b[k - 1] + Math.max(MIN, (s[k] - s[k - 1]) * SPEED));
        }
        s.push(Math.max(s[N - 1] + 1, document.documentElement.scrollHeight - vh));
        b.push(b[N - 1] + Math.max(MIN, (s[N] - s[N - 1]) * SPEED) + W);
        build();
      };
      measure();

      // the world position for a page scroll: linear within each phase
      const worldX = (y: number) => {
        let k = 0;
        while (k < N - 1 && y >= s[k + 1]) k++;
        const t = (y - s[k]) / (s[k + 1] - s[k]);
        return b[k] + (b[k + 1] - b[k]) * (t < 0 ? 0 : t > 1 ? 1 : t);
      };

      const clamp = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : x);
      const lerp = (a: number, c: number, m: number) => a + (c - a) * m;
      let frame = -1, idleTimer = 0, lastSx = -1;
      const paint = () => {
        ticking = false;
        const sx = worldX(scrollY);
        if (sx === lastSx) return;
        lastSx = sx;
        layers.far.style.transform = 'translateX(' + -sx * PARALLAX.far + 'px)';
        layers.mid.style.transform = 'translateX(' + -sx * PARALLAX.mid + 'px)';
        layers.near.style.transform = 'translateX(' + -sx + 'px)';
        // his feet: a frame every 22 px of ground, standing still once the page stops
        const f = Math.floor(sx / 22) % 4;
        if (f !== frame) {
          frame = f;
          me.className = 'me f' + f;
        }
        clearTimeout(idleTimer);
        idleTimer = window.setTimeout(() => (me.className = 'me idle'), 160);
        // the sky, or the wall, turns to the next place's over the last stretch before its door
        const cx = sx + CX;
        let k = 0;
        while (k < N - 1 && cx >= b[k + 1]) k++;
        let t = 0;
        if (k < N - 1) t = clamp((cx - (b[k + 1] - 140)) / 110);
        const a = skies[k], c = skies[Math.min(k + 1, N - 1)];
        strip.style.backgroundColor = 'rgb(' + Math.round(lerp(a[0], c[0], t)) + ',' + Math.round(lerp(a[1], c[1], t)) + ',' + Math.round(lerp(a[2], c[2], t)) + ')';
      };
      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(paint);
        }
      };
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', () => {
        // an in-app browser's bar sliding away is not a new phone: only a new width rebuilds
        if (innerWidth !== vw) {
          vw = innerWidth;
          measure();
          lastSx = -1;
        }
        onScroll();
      });
      addEventListener('orientationchange', () => setTimeout(() => ((vw = innerWidth), measure(), (lastSx = -1), onScroll()), 300));
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => (measure(), (lastSx = -1), onScroll()));
      paint();
    </script>
  </body>
</html>

<style is:global define:vars={{ idle: frames.idle, f0: frames.f0, f1: frames.f1, f2: frames.f2, f3: frames.f3 }}>
  :root {
    --ink: #0a0a0a;
    --paper: #ededed;
    --dim: #9a9a9a;
    --vh: 1vh;
  }
  html,
  body {
    margin: 0;
    background: var(--ink);
    color: var(--paper);
  }
  body {
    -webkit-text-size-adjust: 100%;
  }

  /* the words: one continuous text, the top of the screen, room left under for the walk */
  .j {
    padding: 8vh 0 48vh;
    padding: calc(var(--vh) * 8) 0 calc(var(--vh) * 48);
  }
  .tx {
    padding: 0 8% 0 7%;
    margin: 0 0 36px;
  }
  .tx h1 {
    font-size: 26px;
    line-height: 1.1;
    margin: 0 0 8px;
  }
  .tx .role {
    color: var(--dim);
    margin-bottom: 22px;
  }
  .tx p {
    font-size: 15.5px;
    line-height: 1.55;
    margin: 0 0 12px;
    max-width: 34em;
  }
  .end {
    display: flex;
    flex-wrap: wrap;
    padding: 10px 7% 0;
    font-family: var(--f-mono);
    font-size: var(--t-label);
    letter-spacing: 0.06em;
  }
  .end a {
    color: var(--dim);
    border-bottom-color: #333;
    margin: 0 18px 8px 0;
  }

  /* the walk: the bottom two fifths, fixed */
  .strip {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: 40vh;
    height: calc(var(--vh) * 40);
    overflow: hidden;
    background: #1c2133;
    z-index: 2;
  }
  .layer {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    will-change: transform;
  }
  .seg {
    position: absolute;
    top: 0;
    bottom: 0;
    overflow: hidden;
  }
  .p {
    position: absolute;
    display: block;
  }
  .p > i,
  .p::before,
  .p::after {
    position: absolute;
    display: block;
    pointer-events: none;
  }

  /* him */
  .me {
    position: absolute;
    bottom: 34px;
    width: 56px;
    height: 80px;
    z-index: 3;
  }
  .me .px {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 1px;
    transform: scale(4);
    transform-origin: 0 0;
    box-shadow: var(--idle);
  }
  .me.f0 .px {
    box-shadow: var(--f0);
  }
  .me.f1 .px {
    box-shadow: var(--f1);
    top: -2px;
  }
  .me.f2 .px {
    box-shadow: var(--f2);
  }
  .me.f3 .px {
    box-shadow: var(--f3);
    top: -2px;
  }

  /* what the props wear */
  .s-door::before {
    content: '';
    left: 6px;
    right: 6px;
    top: 6px;
    bottom: 0;
    background: #0a0a0a;
  }
  .s-city {
    -webkit-clip-path: polygon(0 100%, 0 55%, 6% 55%, 6% 35%, 11% 35%, 11% 60%, 18% 60%, 18% 25%, 24% 25%, 24% 50%, 31% 50%, 31% 40%, 38% 40%, 38% 65%, 45% 65%, 45% 30%, 52% 30%, 52% 55%, 58% 55%, 58% 20%, 66% 20%, 66% 50%, 72% 50%, 72% 35%, 80% 35%, 80% 60%, 88% 60%, 88% 42%, 94% 42%, 94% 58%, 100% 58%, 100% 100%);
    clip-path: polygon(0 100%, 0 55%, 6% 55%, 6% 35%, 11% 35%, 11% 60%, 18% 60%, 18% 25%, 24% 25%, 24% 50%, 31% 50%, 31% 40%, 38% 40%, 38% 65%, 45% 65%, 45% 30%, 52% 30%, 52% 55%, 58% 55%, 58% 20%, 66% 20%, 66% 50%, 72% 50%, 72% 35%, 80% 35%, 80% 60%, 88% 60%, 88% 42%, 94% 42%, 94% 58%, 100% 58%, 100% 100%);
    background-image: repeating-linear-gradient(90deg, rgba(255, 220, 160, 0.22) 0 2px, transparent 2px 9px), repeating-linear-gradient(180deg, rgba(255, 220, 160, 0.22) 0 2px, transparent 2px 10px);
  }
  .s-glass {
    background-image: linear-gradient(180deg, #151b2e, rgba(62, 84, 132, 0) 70%), repeating-linear-gradient(90deg, transparent 0 56px, #1a1f2e 56px 59px);
    box-shadow: inset 0 0 0 3px #1a1f2e;
  }
  .s-pendant {
    background: transparent !important;
  }
  .s-pendant::before {
    content: '';
    left: 48%;
    width: 2px;
    top: 0;
    height: 78%;
    background: currentColor;
  }
  .s-pendant::after {
    content: '';
    left: 0;
    right: 0;
    top: 76%;
    height: 24%;
    background: currentColor;
    border-radius: 50% 50% 8% 8%;
    box-shadow: 0 10px 28px 6px rgba(255, 231, 194, 0.35);
  }
  .s-lcd {
    box-shadow: inset 0 0 0 2px #1a1a1a;
  }
  .s-game {
    background-image: radial-gradient(ellipse at 50% 60%, rgba(120, 170, 255, 0.55), rgba(120, 170, 255, 0) 70%);
    box-shadow: inset 0 0 0 2px #0d1016;
  }
  .s-on {
    background-image: radial-gradient(ellipse at 50% 50%, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0) 70%);
  }
  .s-bed::before {
    content: '';
    left: 6%;
    top: 14%;
    width: 22%;
    height: 34%;
    background: #e8e8e8;
    border-radius: 18%;
  }
  .s-curtain {
    background-image: repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.18) 0 3px, transparent 3px 14px);
  }
  .s-grille {
    background-image: repeating-linear-gradient(90deg, rgba(60, 45, 30, 0.75) 0 2px, transparent 2px 22px), repeating-linear-gradient(180deg, rgba(60, 45, 30, 0.75) 0 2px, transparent 2px 22px);
  }
  .s-poster::before {
    content: '';
    left: 15%;
    right: 15%;
    top: 78%;
    height: 7%;
    background: #eee;
  }
  .s-tube {
    box-shadow: 0 0 28px 8px rgba(255, 255, 255, 0.45);
  }
  .s-sun {
    box-shadow: 0 0 40px 14px rgba(255, 243, 196, 0.55);
  }
  .s-trees {
    -webkit-clip-path: polygon(0 100%, 0 40%, 8% 20%, 16% 45%, 24% 10%, 32% 40%, 40% 25%, 48% 50%, 56% 15%, 64% 40%, 72% 20%, 80% 45%, 88% 10%, 96% 35%, 100% 50%, 100% 100%);
    clip-path: polygon(0 100%, 0 40%, 8% 20%, 16% 45%, 24% 10%, 32% 40%, 40% 25%, 48% 50%, 56% 15%, 64% 40%, 72% 20%, 80% 45%, 88% 10%, 96% 35%, 100% 50%, 100% 100%);
  }
  .s-android::before,
  .s-android::after {
    content: '';
    top: 28%;
    width: 10%;
    height: 8%;
    background: #fff;
    border-radius: 50%;
  }
  .s-android::before {
    left: 30%;
  }
  .s-android::after {
    left: 60%;
  }
  .s-spines {
    background-image: repeating-linear-gradient(90deg, #b85c3a 0 6px, #3a5a8a 6px 10px, #d9b24a 10px 13px, transparent 13px 19px);
  }
  .s-porthole {
    box-shadow: inset 0 0 0 4px #c7cad1;
  }
  .s-porthole::before {
    content: '';
    left: 10%;
    right: 10%;
    bottom: 12%;
    height: 24%;
    background: #7a8a66;
    border-radius: 40%;
  }
  .s-map {
    background-image: linear-gradient(22deg, transparent 48%, #7fb1ff 48% 52%, transparent 52%);
  }
  .s-slide::before {
    content: '';
    left: 10%;
    top: 16%;
    width: 48%;
    height: 11%;
    background: #fff;
  }
  .s-tiers {
    background-image: repeating-linear-gradient(180deg, rgba(0, 0, 0, 0.4) 0 2px, transparent 2px 10px), repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.28) 0 2px, transparent 2px 12px);
  }
  .s-sails {
    -webkit-clip-path: polygon(0 100%, 10% 30%, 20% 100%, 30% 20%, 40% 100%, 50% 25%, 60% 100%, 70% 30%, 80% 100%, 90% 20%, 100% 100%);
    clip-path: polygon(0 100%, 10% 30%, 20% 100%, 30% 20%, 40% 100%, 50% 25%, 60% 100%, 70% 30%, 80% 100%, 90% 20%, 100% 100%);
  }
  .s-mountains {
    -webkit-clip-path: polygon(0 100%, 0 60%, 12% 30%, 22% 55%, 34% 10%, 46% 50%, 58% 25%, 70% 60%, 82% 20%, 92% 50%, 100% 40%, 100% 100%);
    clip-path: polygon(0 100%, 0 60%, 12% 30%, 22% 55%, 34% 10%, 46% 50%, 58% 25%, 70% 60%, 82% 20%, 92% 50%, 100% 40%, 100% 100%);
  }
  .s-skyline {
    -webkit-clip-path: polygon(0 100%, 0 50%, 6% 50%, 6% 30%, 12% 30%, 12% 55%, 20% 55%, 20% 20%, 28% 20%, 28% 45%, 36% 45%, 36% 35%, 44% 35%, 44% 60%, 52% 60%, 52% 25%, 60% 25%, 60% 50%, 68% 50%, 68% 15%, 74% 15%, 74% 45%, 82% 45%, 82% 30%, 90% 30%, 90% 55%, 100% 55%, 100% 100%);
    clip-path: polygon(0 100%, 0 50%, 6% 50%, 6% 30%, 12% 30%, 12% 55%, 20% 55%, 20% 20%, 28% 20%, 28% 45%, 36% 45%, 36% 35%, 44% 35%, 44% 60%, 52% 60%, 52% 25%, 60% 25%, 60% 50%, 68% 50%, 68% 15%, 74% 15%, 74% 45%, 82% 45%, 82% 30%, 90% 30%, 90% 55%, 100% 55%, 100% 100%);
  }
  .s-tower::before {
    content: '';
    left: -14px;
    right: -14px;
    top: 28%;
    height: 10%;
    background: currentColor;
    border-radius: 50%;
  }
  .s-hill {
    -webkit-clip-path: polygon(0 100%, 0 70%, 20% 55%, 40% 35%, 60% 25%, 80% 15%, 100% 10%, 100% 100%);
    clip-path: polygon(0 100%, 0 70%, 20% 55%, 40% 35%, 60% 25%, 80% 15%, 100% 10%, 100% 100%);
    background-image: repeating-linear-gradient(90deg, rgba(255, 210, 122, 0.3) 0 2px, transparent 2px 11px), repeating-linear-gradient(180deg, rgba(255, 210, 122, 0.3) 0 2px, transparent 2px 13px);
  }
  .s-ferry::before {
    content: '';
    left: 0;
    right: 0;
    top: 30%;
    height: 40%;
    background-image: repeating-linear-gradient(90deg, #ffd27a 0 3px, transparent 3px 8px);
  }
  .s-volta {
    background-image: linear-gradient(180deg, transparent 8%, #ffe7c2 8% 24%, transparent 24%), repeating-linear-gradient(90deg, rgba(255, 231, 194, 0.18) 0 3px, transparent 3px 12px);
  }
  .s-lit {
    box-shadow: 0 0 24px 8px rgba(255, 210, 122, 0.45);
  }
  .s-banner::before {
    content: '';
    left: 15%;
    right: 15%;
    top: 60%;
    height: 4%;
    background: #c9a227;
  }
  .s-chairs {
    background: transparent !important;
    background-image: repeating-linear-gradient(90deg, currentColor 0 18px, transparent 18px 26px) !important;
  }
  .s-brick {
    background-image: repeating-linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0 2px, transparent 2px 11px), repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.12) 0 2px, transparent 2px 22px);
  }
  .s-fmark::before {
    content: 'F';
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    font: 700 44px/50px var(--f-display);
    text-align: center;
    color: #8a5a48;
  }
  .s-skyline-w {
    box-shadow: inset 0 0 0 3px #e4e0d8;
    background-image: linear-gradient(180deg, transparent 55%, rgba(60, 70, 90, 0.35) 55%), repeating-linear-gradient(90deg, transparent 0 14px, rgba(60, 70, 90, 0.5) 14px 20px, transparent 20px 30px, rgba(60, 70, 90, 0.35) 30px 34px);
