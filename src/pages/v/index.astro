---
// The phone journey, framed: on a desktop the walk stands in a 390 by 844 phone
// in the middle of the page; on a phone this page hands over to the walk.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Phone | Vansh Sood</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      if (innerWidth < 600) location.replace('/v/walk');
    </script>
  </head>
  <body>
    <iframe src="/v/walk" title="The phone journey" width="390" height="844"></iframe>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    min-height: 100vh;
    background: #1c1c1c;
  }
  body {
    display: grid;
    place-items: center;
    padding: 24px 0;
  }
  iframe {
    display: block;
    width: 390px;
    height: min(844px, 100vh - 48px);
    border: 1px solid #333;
    background: #0a0a0a;
  }
</style>
