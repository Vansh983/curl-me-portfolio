---
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import Journey from '../components/Journey.astro';
import { profile } from '../data/profile';
---

<Base topbar={false} footer={false}>
  <section class="story">
    <Journey>
      <div slot="hero" class="hero">
        <Wordmark />
        <p class="role">Shipping software since 13. Head of Engineering at <a href={profile.company.url}>Floqer</a>.</p>
        <p class="mut">{profile.summary}</p>
        <p class="links">
          {profile.links.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href={`mailto:${profile.email}`}>Email</a>
        </p>
      </div>
    </Journey>
  </section>
</Base>

<style>
  .hero {
    padding: 0;
  }
  .role {
    font-size: 19px;
    margin: 16px 0 12px;
  }
  .story {
    margin-top: 0;
  }
  /* the scroll ends in the journey's last room: nothing under it, not even the shell's foot */
  :global(main.shell) {
    padding-bottom: 0;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 22px;
    font-family: var(--f-mono);
    font-size: var(--t-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
