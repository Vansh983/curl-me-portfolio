---
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import Timeline from '../components/Timeline.astro';
import Field from '../components/Field.astro';
import { profile } from '../data/profile';
import { featured, projects } from '../data/projects';
import { getCollection } from 'astro:content';
import { short } from '../lib/date';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const work = featured.slice(0, 6);
---

<Base>
  <section class="hero">
    <Wordmark />
    <p class="role">{profile.role}. Currently building <a href={profile.company.url}>Floqer</a>.</p>
    <p class="mut">{profile.summary}</p>
    <p class="links">
      {profile.links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href={`mailto:${profile.email}`}>Email</a>
    </p>
  </section>

  <section class="block">
    <p class="label">Timeline</p>
    <Timeline />
  </section>

  <section class="block">
    <Field label="field.js" />
  </section>

  <section class="block">
    <p class="label">Selected work</p>
    {
      work.map((p) => (
        <div class="row">
          <span class="yr">{p.year}</span>
          <span>
            {p.url ? <a href={p.url}>{p.title}</a> : p.title}
            {p.description && <span class="small mut desc">{p.description}</span>}
          </span>
          <span class="meta">{p.tags.slice(0, 2).join(', ')}</span>
        </div>
      ))
    }
    <p class="more small"><a href="/archive">All {projects.length} projects</a></p>
  </section>

  <section class="block">
    <p class="label">Writing</p>
    {
      posts.map((p) => (
        <div class="row">
          <span class="yr">{short(p.data.pubDate)}</span>
          <span>
            <a href={`/blog/${p.id}`}>{p.data.title}</a>
          </span>
          <span class="meta">{p.data.tags[0] ?? ''}</span>
        </div>
      ))
    }
    <p class="more small"><a href="/blog">All writing</a> &middot; <a href="/rss.xml">RSS</a></p>
  </section>
</Base>

<style>
  .hero {
    padding: 30px 0 0;
  }
  .role {
    font-size: 19px;
    margin: 16px 0 12px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 22px;
    font-family: var(--f-mono);
    font-size: var(--t-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .desc {
    display: block;
  }
  .more {
    margin-top: 14px;
  }
</style>
